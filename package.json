{
  "name": "aiduchi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "server",
    "packages/protocol"
  ],
  "scripts": {
    "dev": "npm --prefix server run dev & npm --prefix apps/web run dev",
    "dev:sync": "npm --prefix server run dev:sync",
    "build": "npm --workspace packages/protocol run build && npm --workspace server run build && npm --workspace apps/web run build",
    "start": "npm --prefix server run start",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "mp4-muxer": "^5.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
