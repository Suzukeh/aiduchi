PORT=3000
SYNC_PORT=1234
WEB_ORIGIN=http://localhost:5173
# ホスト持ちAIキー（P0はダミー応答でも可。本番はここに設定）
# baseUrlは /v1 形式で指定（/chat/completions は自動付与。末尾に付いていても正規化される）
# OpenCode Go等で x-opencode-session ヘッダが必須のプロバイダも自動対応
HOST_OPENAI_KEY=
HOST_OPENAI_BASE_URL=https://api.openai.com/v1
ALLOWED_MODELS=gpt-4o-mini
ROOM_MONTHLY_TOKEN_LIMIT=1000000
DATA_DIR=./data
# Tunnel公開ホスト名（Vite/HocuspocusのallowedHosts用）
PUBLIC_HOSTNAME=vtest.suzuke.dev
