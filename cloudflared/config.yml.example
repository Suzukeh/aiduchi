tunnel: aiduchi-dev
credentials-file: ~/.cloudflared/<TUNNEL_ID>.json
ingress:
  # アプリ本体（Vite → /api, /sync プロキシ）
  - hostname: vtest.suzuke.dev
    service: http://localhost:5173
  - service: http_status:404
# 身内公開なら dash側で hostname に Cloudflare Access(OTP) を付ける。
# Quick TunnelはランダムURL・SSE不可のため非推奨。必ずNamedを使う。
